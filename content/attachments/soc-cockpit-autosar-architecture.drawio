  <diagram id="soc_autosar_clean" name="Cockpit SoC Architecture (Clean Layout)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== HEADER & TITLE ==================== -->
        <mxCell id="title_banner" value="&lt;b style=&quot;font-size: 18px;&quot;&gt;座舱 SoC 跨平台车辆通信与 AUTOSAR AP 数据流转架构&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color: #555; font-size: 12px;&quot;&gt;分层清晰：上层 HMI 交互 (AAOS) ── 中间件中枢 (QNX / AUTOSAR AP) ── 底层车控执行 (Classic MCU)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1680" height="60" as="geometry" />
        </mxCell>

        <!-- ==================== 1. AAOS 娱乐交互域 (左侧) ==================== -->
        <mxCell id="aaos_box" value="&lt;b style=&quot;font-size: 15px; color: #2E7D32;&quot;&gt;1. AAOS 智能座舱娱乐域 (Android)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#4CAF50;strokeWidth=2.5;verticalAlign=top;align=center;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="280" height="740" as="geometry" />
        </mxCell>

        <mxCell id="aaos_desc" value="• 面向车机 UI 与三方应用&lt;br/&gt;• 面向 Vehicle Property 属性编程&lt;br/&gt;• 屏蔽底层总线协议细节" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8E6C9;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="app_cluster" value="&lt;b&gt;Android HMI / Apps&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #555;&quot;&gt;空调 / 设置 / 门窗 / 多媒体&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4CAF50;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="240" width="220" height="70" as="geometry" />
