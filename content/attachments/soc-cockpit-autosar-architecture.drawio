        <mxCell id="flow_nonap_udp" value="UDP Socket" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#1976D2;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="non_ap_cluster" target="udp_server_cluster">
