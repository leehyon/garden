        <mxCell id="udp_server_cluster" value="&lt;b&gt;UDP Socket Server&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #1565C0;&quot;&gt;172.16.1.1:12345&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #666;&quot;&gt;IPC 数据分发/控制中继&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="160" width="220" height="70" as="geometry" />
