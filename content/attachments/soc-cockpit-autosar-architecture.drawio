        <mxCell id="vhal_cluster" value="&lt;b&gt;SRDC VHAL&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #555;&quot;&gt;Vehicle HAL (gRPC 客户端)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="520" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="flow_app_vhal" value="&lt;b&gt;Vehicle Properties&lt;/b&gt;&lt;br/&gt;(Get / Set / Sub)" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#2E7D32;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="app_cluster" target="vhal_cluster">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>


        <!-- ==================== 2. QNX 宿主与非 AP 原生服务 (上方) ==================== -->
        <mxCell id="qnx_box" value="&lt;b style=&quot;font-size: 15px; color: #6A1B9A;&quot;&gt;2. QNX 宿主安全域 (172.16.27.43)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#8E24AA;strokeWidth=2.5;verticalAlign=top;align=left;spacingLeft=20;arcSize=3;" vertex="1" parent="1">
